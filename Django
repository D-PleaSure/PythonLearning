http://192.168.50.234:8000/lcmonitor/index/
http://127.0.0.1:8000/lcmonitor/index/


SELECT
    i.owner AS index_owner,
    i.table_owner,
    i.index_name,
    i.index_type,
    i.status,
    i.visibility,
    c.column_position,
    c.column_name,
    c.descend,
    i.num_rows,
    i.last_analyzed
FROM all_indexes i
JOIN all_ind_columns c
  ON c.index_owner = i.owner
 AND c.index_name = i.index_name
WHERE i.table_name = 'TB_SETTLE_HOZON'
ORDER BY i.table_owner, i.index_name, c.column_position;
