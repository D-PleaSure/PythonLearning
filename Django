
# ファイル名のみを取得する（フォルダーパスは除外）
$fileName = [System.IO.Path]::GetFileName($item.Right)

# 集計結果にファイル名列を追加する
$summary.Add([pscustomobject][ordered]@{
    LeftFile  = $item.Left
    RightFile = $item.Right
    FileName  = $fileName
    LeftOnly  = $deleted
    RightOnly = $added
    Different = $changed
    Status    = 'OK'
})
