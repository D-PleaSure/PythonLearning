SELECT
    SYSTIMESTAMP AS sampled_at,
    s.sid,
    s.serial#,
    s.username,
    s.machine,
    s.program,
    s.module,
    s.status,
    s.sql_id,
    s.sql_child_number,
    s.sql_exec_start,
    ROUND((SYSDATE - s.sql_exec_start) * 86400) AS sql_elapsed_seconds,
    s.state,
    s.event,
    s.wait_class,
    s.seconds_in_wait,
    s.blocking_session_status,
    s.blocking_instance,
    s.blocking_session,
    q.plan_hash_value,
    q.sql_text
FROM v$session s
JOIN v$sql q
  ON q.sql_id = s.sql_id
 AND q.child_number = s.sql_child_number
WHERE s.type = 'USER'
  AND s.status = 'ACTIVE'
  AND s.sid <> TO_NUMBER(SYS_CONTEXT('USERENV', 'SID'))
  AND UPPER(q.sql_text) LIKE '%TB_SETTLE_HOZON%'
  AND UPPER(q.sql_text) LIKE '%MAX(AMEND_TIME)%'
ORDER BY s.sql_exec_start;



SELECT plan_table_output
