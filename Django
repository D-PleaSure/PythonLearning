SELECT
    SYSTIMESTAMP AS sampled_at,
    sid,
    serial#,
    username,
    machine,
    program,
    status,
    sql_id,
    sql_child_number,
    prev_sql_id,
    state,
    event,
    wait_class,
    blocking_session_status,
    blocking_session
FROM v$session
WHERE type = 'USER'
  AND username = SYS_CONTEXT('USERENV', 'SESSION_USER')
  AND sid <> TO_NUMBER(SYS_CONTEXT('USERENV', 'SID'))
ORDER BY status, machine, sid;
