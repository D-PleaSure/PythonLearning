class SettleCountDetailForm(TargetMonthForm):
    deal = forms.ChoiceField(
        label='業務',
        choices=[
            (1, '当預'),
            (2, '内為'),
            (3, '国債'),
            (4, '担保'),
            (5, '外為'),
            (6, '社債'),
        ],
        widget=forms.RadioSelect(
            attrs={'class': 'settle-detail-radio'}
        ),
        initial=1,
    )

    count_or_amount = forms.ChoiceField(
        label='件数/金額',
        choices=[
            (1, '件数'),
            (2, '金額'),
        ],
        widget=forms.RadioSelect(
            attrs={'class': 'settle-detail-radio'}
        ),
        initial=1,
    )



