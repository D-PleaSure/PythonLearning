
# Beyond Compare 統計CSV集約ツール
# 既存の個別レポートから3種類の差分件数を抽出する
# Beyond Compareの再実行は不要

$WorkDir = 'D:\TOOL\Beyond Compare 3\Reports'
$ReportDir = Join-Path $WorkDir 'detail_reports'
$OutputFile = Join-Path $WorkDir 'summary_result.csv'
$ErrorFile = Join-Path $WorkDir 'summary_parse_errors.csv'

$ErrorActionPreference = 'Stop'

# 個別レポートを取得する
$files = @(
    Get-ChildItem -LiteralPath $ReportDir `
        -Filter 'report_*.csv' -File |
    Sort-Object Name
)

$results = New-Object 'System.Collections.Generic.List[object]'
$errors = New-Object 'System.Collections.Generic.List[object]'

foreach ($file in $files) {
    try {
        # 先頭2行はレポート情報のため除外する
        # 3行目からCSVとして読み込む
        $lines = @(
            Get-Content -LiteralPath $file.FullName `
                -Encoding UTF8 |
            Select-Object -Skip 2
        )

        if ($lines.Count -lt 2) {
            throw 'CSVデータが不足しています'
        }

        $rows = @($lines | ConvertFrom-Csv)

        foreach ($row in $rows) {
            # 必要な列が存在するか確認する
            foreach ($name in @(
                'SourceFile','CompareFile',
                'IDeleted','IAdded','IChanged'
            )) {
                if ($row.PSObject.Properties.Name -notcontains $name) {
                    throw "必要な列がありません: $name"
                }
            }

            # 数値変換に失敗した場合はエラーとして記録
            $deleted = 0
            $added = 0
            $changed = 0

            if (-not [int]::TryParse($row.IDeleted, [ref]$deleted) -or
                -not [int]::TryParse($row.IAdded, [ref]$added) -or
                -not [int]::TryParse($row.IChanged, [ref]$changed)) {
                throw '差分件数が数値ではありません'
            }

            # 差分件数がすべて0の場合は出力しない
            if (($deleted + $added + $changed) -eq 0) {
                continue
            }

            # 指定した6列で集計する
            $results.Add([pscustomobject][ordered]@{
                LeftFile = $row.SourceFile
                RightFile = $row.CompareFile
                LeftOnly = $deleted
                RightOnly = $added
                Different = $changed
                Status = 'OK'
            })
        }
    }
    catch {
        $errors.Add([pscustomobject]@{
            Report = $file.Name
            Reason = $_.Exception.Message
        })
    }
}

# Excelで開けるCSVを出力する
if ($results.Count -gt 0) {
    $results | Export-Csv -LiteralPath $OutputFile `
        -NoTypeInformation -Encoding UTF8
}

# 読み込みに失敗したレポートを記録する
if ($errors.Count -gt 0) {
    $errors | Export-Csv -LiteralPath $ErrorFile `
        -NoTypeInformation -Encoding UTF8
}

Write-Host '===== 集計結果 ====='
Write-Host "レポート数: $($files.Count)"
Write-Host "差分ファイル数: $($results.Count)"
Write-Host "解析エラー数: $($errors.Count)"
Write-Host "出力先: $OutputFile"
