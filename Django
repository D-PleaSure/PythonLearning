    @staticmethod
    def _text(value):
        if isinstance(value, unicode):
            return value
        if isinstance(value, str):
            return value.decode('utf-8')
        return unicode(value)





    def set_table_header(self, table_header):
        self.csv_table_header = u','.join(
            self._text(value) for value in table_header
        )





    def create_csv(self, record=None):
        self.csv_data = u''

        if self.csv_title:
            self.csv_data += self._text(self.csv_title) + u'\n'

        if self.csv_subtitle:
            self.csv_data += self._text(self.csv_subtitle) + u'\n'

        if self.csv_table_header:
            self.csv_data += self._text(self.csv_table_header) + u'\n'

        if record is not None and record != []:
            self.csv_table_body = record

        for row in self.csv_table_body:
            self.csv_data += u','.join(
                self._text(value) for value in row
            )
            self.csv_data += u'\n'

        return self.csv_data
