
# 3種類の差分件数を確認する
# すべて0の場合は集計対象から除外する
# いずれかが1以上の場合のみ出力する

if ($deleted -ne 0 -or
    $added -ne 0 -or
    $changed -ne 0) {

    $summary.Add([pscustomobject][ordered]@{
        LeftFile  = $item.Left
        RightFile = $item.Right
        LeftOnly  = $deleted
        RightOnly = $added
        Different = $changed
        Status    = 'OK'
    })
}
