    def clean_month(self):
        month = self.cleaned_data['month']

        # 半角数字6桁のyyyymm形式を確認する
        if not re.fullmatch(r'[0-9]{6}', month):
            raise forms.ValidationError(
                "This field required 'yyyymm' format"
            )

        # 年月が実在することを確認する
        try:
            datetime.date(
                int(month[:4]),
                int(month[4:6]),
                1
            )
        except ValueError:
            raise forms.ValidationError(
                "Enter a valid month (yyyymm)."
            )

        return month
