def graph_output(mtime):
    if not os.path.isdir(settings.GRAPH_ROOT):
        os.makedirs(settings.GRAPH_ROOT)
    filename = 'graph_%s.png' % mtime
    return settings.GRAPH_URL + filename, os.path.join(settings.GRAPH_ROOT, filename)

